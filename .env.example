# Salin file ini menjadi .env.local lalu isi nilainya.

# Meta Graph API (Instagram & Facebook) — lihat lib/metaApi.js untuk cara
# memperoleh token ini melalui https://developers.facebook.com/apps
META_ACCESS_TOKEN=

# Kunci opsional untuk melindungi endpoint scraping dari pemicu sembarangan
# (dikirim sebagai header x-scrape-key). Kosongkan jika tidak diperlukan.
SCRAPE_TRIGGER_KEY=

# PIN akses Tim Neraca untuk membuka fitur validasi fenomena
NERACA_PIN=rajaampat9201 